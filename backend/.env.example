# Backend settings. Locally: copy to backend/.env (never commit it).
# On Railway: set ONLY the variables in the first section.

# ---- Set these everywhere (including Railway) ----
# Exact origins allowed to call the API (CORS), comma-separated, no wildcards.
# Add http://localhost:8080 for local development.
ALLOWED_ORIGINS=https://zecstart.jayden-3af.workers.dev
# Which proxy header carries the visitor's IP (used for rate limits):
# "railway" on Railway, "cloudflare" behind a Cloudflare Tunnel, empty otherwise.
TRUST_PROXY=railway
# Light-wallet server.
INDEXER=https://testnet.zec.rocks:443
# Operator-only routes (POST /zcash/api/admin/split): 24+ random characters.
# Leave unset to disable them.
ADMIN_TOKEN=
# On Railway, match the domain's target port.
PORT=8787

# ---- Local only: the Docker image already sets these. Do NOT set them on Railway ----
# HOST=127.0.0.1
# ZINGO_BIN=/absolute/path/to/zingo-cli
# WALLET_DIR=./wallets
# API_BASE=/zcash/api
# SWEEP_MINUTES=15
