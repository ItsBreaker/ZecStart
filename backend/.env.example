# Copy to backend/.env and adjust. Never commit the real .env.
PORT=8787
HOST=127.0.0.1
# Path prefix the API is served under.
API_BASE=/zcash/api
# Comma-separated list of the exact origins allowed to call the API (CORS).
# No wildcards: list each deployed site (add http://localhost:8080 for local dev).
ALLOWED_ORIGINS=https://zecstart.jayden-3af.workers.dev
# "railway" on Railway, "cloudflare" behind a Cloudflare Tunnel, so per-IP rate
# limits use the visitor's IP, not the proxy's.
TRUST_PROXY=
# Path to a zingo-cli binary and the testnet indexer it talks to.
ZINGO_BIN=/path/to/zingo-cli
INDEXER=https://testnet.zec.rocks:443
# Where the custodial wallets live (gitignored).
WALLET_DIR=./wallets
SWEEP_MINUTES=15
# Operator-only routes (POST /zcash/api/admin/split). 24+ random characters;
# leave unset to disable them.
ADMIN_TOKEN=
