# Copy to backend/.env and adjust. Never commit the real .env.
PORT=8787
HOST=127.0.0.1
# Path prefix the API is served under.
API_BASE=/zcash/api
# Comma-separated list of sites allowed to call the API (CORS).
ALLOWED_ORIGINS=https://shielded101.pages.dev,http://localhost:8080
# Set to "cloudflare" when running behind a Cloudflare Tunnel, so per-IP rate
# limits use the visitor's IP (CF-Connecting-IP), not the tunnel's.
TRUST_PROXY=
# Path to a zingo-cli binary and the testnet indexer it talks to.
ZINGO_BIN=/path/to/zingo-cli
INDEXER=https://testnet.zec.rocks:443
# Where the custodial wallets live (gitignored).
WALLET_DIR=./wallets
SWEEP_MINUTES=15
